fluidRow(box(width=12, status="success", title="Key Takeaway", uiOutput("scatter_insight")))
),
# PAGE 3 ── TRENDS ─────────────────────────────────────────────────────
tabItem("trends",
fluidRow(column(12, info_box(strong("Decision lens: "), "Is the Yzerplan working? Detroit vs league 2021-2025."))),
fluidRow(column(4,
selectInput("trend_metric", "Metric", choices=metric_labels, selected="xGF.")
)),
fluidRow(
box(width=8, status="primary", plotlyOutput("trend_plot", height="400px")),
box(width=4, status="warning", title="Detroit Detail", solidHeader=TRUE, DTOutput("trend_table"))
),
fluidRow(box(width=12, status="success", title="Key Takeaway", uiOutput("trend_insight")))
),
# PAGE 4 ── SIMULATOR ──────────────────────────────────────────────────
tabItem("simulator",
fluidRow(column(12, info_box(strong("Cap Allocation Simulator: "),
"Model the impact of Yzerman's $12.8M decision on Detroit's projected standings."))),
fluidRow(
box(width=4, title="Allocation Controls", status="danger", solidHeader=TRUE,
sliderInput("off_pct", "% to Elite Offence", 0, 100, 50, step=5, post="%"),
strong("Remainder goes to Elite Defence/Depth"), br(), br(),
tableOutput("alloc_table"), hr(),
sliderInput("xgf_m",  "xGF% gain per $1M (Offence)",  0.1, 0.8, 0.30, 0.05),
sliderInput("hdcf_m", "HDCF% gain per $1M (Offence)", 0.1, 0.8, 0.25, 0.05),
sliderInput("hdca_m", "HDCF% gain per $1M (Defence)", 0.1, 0.6, 0.20, 0.05)
),
box(width=8, title="Projected Outcomes", status="primary", solidHeader=TRUE,
fluidRow(
valueBoxOutput("vb_xgf",     width=4),
valueBoxOutput("vb_hdcf",    width=4),
valueBoxOutput("vb_pts",     width=4)
),
fluidRow(
valueBoxOutput("vb_rank",    width=6),
valueBoxOutput("vb_playoff", width=6)
),
plotlyOutput("sim_bars", height="240px")
)
),
fluidRow(box(width=12, title="Decision Implication", status="success", solidHeader=TRUE, uiOutput("sim_insight"))),
fluidRow(box(width=12, status="info",
tags$small(icon("info-circle"), strong(" Methodology: "),
"Linear regression on 160 team-seasons (2021-2025), R2=0.49. ",
"Baseline = Detroit 2024-25 extrapolated to 82 games. Playoff threshold = 92 pts.")))
)
)
)
)
# ── SERVER ────────────────────────────────────────────────────────────────────
server <- function(input, output, session) {
# Explorer
output$scatter <- renderPlotly({
d <- filter(games, Season %in% as.integer(input$season_filter))
p <- ggplot(d, aes_string(x=input$x_metric, y="Points_82", colour="is_Detroit",
shape="is_Detroit", size="is_Detroit",
text="paste0(Team,' (',Season,')<br>Points: ',Points_82)")) +
geom_point(alpha=0.8) +
scale_colour_manual(values=c("FALSE"=GRY,"TRUE"=RED)) +
scale_shape_manual(values=c("FALSE"=4,"TRUE"=16)) +
scale_size_manual(values=c("FALSE"=2,"TRUE"=4)) +
geom_vline(xintercept=50, linetype="dashed", colour=BLUE) +
labs(x=input$x_metric, y="Points (82-game pace)", colour=NULL, shape=NULL, size=NULL) +
theme_minimal(base_size=12) + theme(legend.position="none")
if (input$show_trend)
p <- p + geom_smooth(aes(group=1), method="lm", se=FALSE, colour=BLUE,
linewidth=0.8, inherit.aes=FALSE,
mapping=aes_string(x=input$x_metric, y="Points_82"))
ggplotly(p, tooltip="text")
})
output$scatter_insight <- renderUI({
d   <- filter(games, Season %in% as.integer(input$season_filter))
det <- filter(d, is_Detroit)
gap <- round(mean(d[[input$x_metric]]) - mean(det[[input$x_metric]]), 2)
good_box(icon("lightbulb"), strong(" Detroit vs League: "),
paste0("Detroit averages ", round(mean(det[[input$x_metric]]),2),
"% vs the league's ", round(mean(d[[input$x_metric]]),2),
"% - a gap of ", gap, " points. The dashed line marks the 50% break-even threshold."))
})
# Trends
output$trend_plot <- renderPlotly({
m     <- input$trend_metric
lbl   <- names(metric_labels)[metric_labels == m]
det_d <- filter(games, is_Detroit) %>% arrange(Season) %>% select(Season, val=all_of(m))
avg_d <- league_avg %>% select(Season, val=all_of(m))
p <- ggplot() +
geom_line(data=avg_d,  aes(Season,val,colour="League Avg"), linewidth=1.2, linetype="dashed") +
geom_point(data=avg_d, aes(Season,val,colour="League Avg"), size=3) +
geom_line(data=det_d,  aes(Season,val,colour="Detroit"),    linewidth=1.8) +
geom_point(data=det_d, aes(Season,val,colour="Detroit"),    size=5) +
scale_colour_manual(values=c("Detroit"=RED,"League Avg"=GRY)) +
scale_x_continuous(breaks=sort(unique(games$Season))) +
labs(x="Season", y=lbl, colour=NULL) +
theme_minimal(base_size=12) + theme(legend.position="bottom")
if (m %in% c("xGF.","HDCF."))
p <- p + geom_hline(yintercept=50, linetype="dotted", colour=BLUE)
ggplotly(p) %>% layout(legend=list(orientation="h", y=-0.15))
})
output$trend_table <- renderDT({
filter(games, is_Detroit) %>% arrange(Season) %>%
select(Season, W, L, Pts=Points_82, xGF=xGF., HDCF=HDCF.) %>%
datatable(options=list(pageLength=5, dom="t"), rownames=FALSE)
})
output$trend_insight <- renderUI({
m   <- input$trend_metric
d   <- filter(games, is_Detroit) %>% arrange(Season)
chg <- round(last(d[[m]]) - first(d[[m]]), 2)
good_box(icon("chart-line"), strong(" Trend: "),
paste0("Detroit's ", names(metric_labels)[metric_labels==m],
" changed by ", ifelse(chg>0,"+",""), chg, " from 2021 to 2025."))
})
# Simulator
p_vals <- reactive({
off <- 12.8 * input$off_pct / 100
def <- 12.8 - off
px  <- min(base_xgf  + off*input$xgf_m, 62)
ph  <- min(base_hdcf + off*input$hdcf_m + def*input$hdca_m, 62)
pp  <- max(60, min(130, predict(model, data.frame(xGF.=px, HDCF.=ph))))
rk  <- sum(filter(games, Season==2024)$Points_82 > pp) + 1
list(off=off, def=def, px=px, ph=ph, pp=pp,
dx=px-base_xgf, dh=ph-base_hdcf, dp=pp-base_pts,
rk=rk, playoff=pp>=92)
})
output$alloc_table <- renderTable({
v <- p_vals()
data.frame(
Allocation = c("Elite Offence","Elite Defence","Total"),
Pct        = c(paste0(input$off_pct,"%"), paste0(100-input$off_pct,"%"), "100%"),
Amount     = c(paste0("$",round(v$off,1),"M"), paste0("$",round(v$def,1),"M"), "$12.8M")
)
}, striped=TRUE, bordered=TRUE)
output$vb_xgf    <- renderValueBox(valueBox(paste0(round(p_vals()$px,2),"%"),
paste0("xGF% (",sprintf("%+.2f",p_vals()$dx),"%)"), icon("crosshairs"),
color=if(p_vals()$px>=50)"green" else "yellow"))
output$vb_hdcf   <- renderValueBox(valueBox(paste0(round(p_vals()$ph,2),"%"),
paste0("HDCF% (",sprintf("%+.2f",p_vals()$dh),"%)"), icon("shield-alt"),
color=if(p_vals()$ph>=50)"green" else "yellow"))
output$vb_pts    <- renderValueBox(valueBox(round(p_vals()$pp,0),
paste0("Points (",sprintf("%+.0f",p_vals()$dp)," vs baseline)"), icon("star"),
color=if(p_vals()$pp>=92)"green" else "red"))
output$vb_rank   <- renderValueBox(valueBox(paste0("#",p_vals()$rk," / 32"),
"Est. League Rank", icon("list-ol"),
color=if(p_vals()$rk<=16)"green" else "yellow"))
output$vb_playoff <- renderValueBox(valueBox(
if(p_vals()$playoff)"IN PLAYOFFS" else "MISSED PLAYOFFS",
"Projection (92-pt threshold)",
icon(if(p_vals()$playoff)"check-circle" else "times-circle"),
color=if(p_vals()$playoff)"green" else "red"))
output$sim_bars <- renderPlotly({
v  <- p_vals()
df <- data.frame(
Category = rep(c("Baseline","Projected"),2),
Metric   = c(rep("xGF%",2),rep("HDCF%",2)),
Value    = c(base_xgf, v$px, base_hdcf, v$ph)
)
p <- ggplot(df, aes(Category, Value, fill=Metric,
text=paste0(Metric,": ",round(Value,2),"%"))) +
geom_col(position="dodge", width=0.6) +
geom_hline(yintercept=50, linetype="dashed") +
scale_fill_manual(values=c("xGF%"=RED,"HDCF%"=BLUE)) +
coord_cartesian(ylim=c(42,58)) +
labs(x=NULL, y="%") + theme_minimal(base_size=11) +
theme(legend.position="bottom")
ggplotly(p, tooltip="text")
})
output$sim_insight <- renderUI({
v <- p_vals(); pct <- input$off_pct
if (pct >= 70)
warn_box(icon("rocket"), strong(paste0(" Aggressive Offence (",pct,"% / $",round(v$off,1),"M): ")),
paste0("Projects xGF% to ",round(v$px,1),"% (+",round(v$dx,1)," pts). High upside but only $",
round(v$def,1),"M left for defence - risks a top-heavy roster."))
else if (pct <= 30)
good_box(icon("shield-alt"), strong(paste0(" Defensive Focus (",100-pct,"% / $",round(v$def,1),"M): ")),
paste0("Improves HDCF% by +",round(v$dh,1)," pts but xGF% only reaches ",round(v$px,1),
"%. xGF% has 6x the point impact - may leave wins on the table."))
else
good_box(icon("balance-scale"), strong(paste0(" Balanced (",pct,"/",100-pct,"): ")),
paste0("Projects ",round(v$pp,0)," points (xGF%: ",round(v$px,1),"%, HDCF%: ",
round(v$ph,1),"%). Consider tilting toward offence given xGF% stronger impact."))
})
}
shinyApp(ui, server)
library(shiny); library(shinydashboard)
library(ggplot2); library(dplyr); library(plotly); library(DT)
# ── Data & Model ──────────────────────────────────────────────────────────────
games <- read.csv("data/games_2021-25.csv", fileEncoding = "UTF-8-BOM") %>%
mutate(
is_Detroit = Team == "Detroit Red Wings",
Points_82  = ifelse(Season == 2025, round(Points * 82 / GP), Points)
)
model     <- lm(Points_82 ~ xGF. + HDCF., data = games)
det       <- filter(games, is_Detroit, Season == 2025)
base_xgf  <- det$xGF.; base_hdcf <- det$HDCF.; base_pts <- det$Points_82
league_avg <- games %>% group_by(Season) %>%
summarise(xGF. = mean(xGF.), HDCF. = mean(HDCF.),
Points_82 = mean(Points_82), .groups = "drop")
RED <- "#CE1126"; BLUE <- "#002654"; GRY <- "#AAAAAA"
metric_labels <- c(
"xGF%"             = "xGF.",
"HDCF%"            = "HDCF.",
"Points (82-game)" = "Points_82"
)
info_box <- function(...) div(style="background:#f0f4f8;border-left:5px solid #002654;padding:12px 16px;border-radius:4px;margin-bottom:14px;", ...)
good_box <- function(...) div(style="background:#eafaf1;border-left:5px solid #27ae60;padding:10px 14px;border-radius:4px;margin-top:10px;font-size:13px;", ...)
warn_box <- function(...) div(style="background:#fff8e1;border-left:5px solid #CE1126;padding:10px 14px;border-radius:4px;margin-top:10px;font-size:13px;", ...)
# ── UI ────────────────────────────────────────────────────────────────────────
ui <- dashboardPage(skin = "red",
dashboardHeader(title = "Breaking the Bubble", titleWidth = 240),
dashboardSidebar(width = 220,
sidebarMenu(id = "tabs",
menuItem("Decision Context", tabName = "context",   icon = icon("info-circle")),
menuItem("League Explorer",  tabName = "explorer",  icon = icon("chart-bar")),
menuItem("Detroit Trends",   tabName = "trends",    icon = icon("chart-line")),
menuItem("Cap Simulator",    tabName = "simulator", icon = icon("sliders-h"))
),
hr(),
tags$div(style="padding:10px;font-size:11px;color:#aaa;",
"Natural Stat Trick & MoneyPuck", br(), "5v5 | 2021-2025 | BSAD 482")
),
dashboardBody(
tags$head(tags$style(HTML("
.skin-red .main-header .logo   { background-color:#002654 !important; }
.skin-red .main-header .navbar { background-color:#CE1126 !important; }
.skin-red .main-sidebar        { background-color:#1a1a2e !important; }
"))),
tabItems(
# PAGE 1 ── CONTEXT ────────────────────────────────────────────────────
tabItem("context",
fluidRow(column(12, info_box(
h4(icon("question-circle"), " The Decision"),
p("Should GM Steve Yzerman allocate Detroit's projected", strong("$12.8M cap space"),
"for 2026-27 toward", strong("Elite Offence"), "(HDCF generation) or",
strong("Elite Defence"), "(HDCF suppression) to maximize Stanley Cup probability?")
))),
fluidRow(
valueBox("9 Seasons",  "Playoff Drought (2016-2025)",        icon("calendar-times"), color="red",  width=3),
valueBox("$12.8M",     "Available Cap Space",                 icon("dollar-sign"),    color="navy", width=3),
valueBox("49.98%",     "Detroit xGF% 2025 (up from 45.75%)", icon("arrow-up"),        color="red",  width=3),
valueBox("50.0%",      "League Break-Even Threshold",         icon("balance-scale"),  color="navy", width=3)
),
fluidRow(
box(width=6, title="The Core Tension", status="danger", solidHeader=TRUE,
tags$ul(
tags$li(strong("Option A - Elite Offence:"), " Star forward generating high-danger chances. 20-30% market premium. Risk: defensive gaps."),
tags$li(strong("Option B - Elite Defence:"), " Reliable defencemen focused on suppression. Better cap value. Risk: offence wins in the modern NHL.")
),
warn_box(icon("exclamation-triangle"), strong(" Key Insight: "),
"Each 1% xGF% gain equals approximately +2.83 standings points - 6x more impactful than HDCF% alone.")
),
box(width=6, title="Where Detroit Stands", status="primary", solidHeader=TRUE,
tags$ul(
tags$li("xGF% climbed from", strong("45.75% (2023) to 49.98% (2025)")),
tags$li("Still below the", strong("50% break-even"), "threshold"),
tags$li("HDCF% at 48.68% vs playoff avg of", strong("52.45%")),
tags$li("2025 on pace for", strong("~102 points over 82 games"))
),
good_box(icon("lightbulb"), strong(" Use the Cap Simulator "),
"to model different allocation strategies and their projected impact.")
)
)
),
# PAGE 2 ── EXPLORER ───────────────────────────────────────────────────
tabItem("explorer",
fluidRow(column(12, info_box(strong("Decision lens: "), "How does Detroit compare to the rest of the NHL?"))),
fluidRow(
column(3, selectInput("x_metric", "X-Axis Metric",
choices=c("xGF%"="xGF.","HDCF%"="HDCF.","CF%"="CF."), selected="xGF.")),
column(5, checkboxGroupInput("season_filter", "Season(s)",
choices=sort(unique(games$Season)), selected=sort(unique(games$Season)), inline=TRUE)),
column(2, br(), checkboxInput("show_trend", "Trend Line", TRUE))
),
fluidRow(box(width=12, status="primary", plotlyOutput("scatter", height="460px"))),
fluidRow(box(width=12, status="success", title="Key Takeaway", uiOutput("scatter_insight")))
),
# PAGE 3 ── TRENDS ─────────────────────────────────────────────────────
tabItem("trends",
fluidRow(column(12, info_box(strong("Decision lens: "), "Is the Yzerplan working? Detroit vs league 2021-2025."))),
fluidRow(column(4,
selectInput("trend_metric", "Metric", choices=metric_labels, selected="xGF.")
)),
fluidRow(
box(width=8, status="primary", plotlyOutput("trend_plot", height="400px")),
box(width=4, status="warning", title="Detroit Detail", solidHeader=TRUE, DTOutput("trend_table"))
),
fluidRow(box(width=12, status="success", title="Key Takeaway", uiOutput("trend_insight")))
),
# PAGE 4 ── SIMULATOR ──────────────────────────────────────────────────
tabItem("simulator",
fluidRow(column(12, info_box(strong("Cap Allocation Simulator: "),
"Model the impact of Yzerman's $12.8M decision on Detroit's projected standings."))),
fluidRow(
box(width=4, title="Allocation Controls", status="danger", solidHeader=TRUE,
sliderInput("off_pct", "% to Elite Offence", 0, 100, 50, step=5, post="%"),
strong("Remainder goes to Elite Defence/Depth"), br(), br(),
tableOutput("alloc_table"), hr(),
sliderInput("xgf_m",  "xGF% gain per $1M (Offence)",  0.1, 0.8, 0.30, 0.05),
sliderInput("hdcf_m", "HDCF% gain per $1M (Offence)", 0.1, 0.8, 0.25, 0.05),
sliderInput("hdca_m", "HDCF% gain per $1M (Defence)", 0.1, 0.6, 0.20, 0.05)
),
box(width=8, title="Projected Outcomes", status="primary", solidHeader=TRUE,
fluidRow(
valueBoxOutput("vb_xgf",     width=4),
valueBoxOutput("vb_hdcf",    width=4),
valueBoxOutput("vb_pts",     width=4)
),
fluidRow(
valueBoxOutput("vb_rank",    width=6),
valueBoxOutput("vb_playoff", width=6)
),
plotlyOutput("sim_bars", height="240px")
)
),
fluidRow(box(width=12, title="Decision Implication", status="success", solidHeader=TRUE, uiOutput("sim_insight"))),
fluidRow(box(width=12, status="info",
tags$small(icon("info-circle"), strong(" Methodology: "),
"Linear regression on 160 team-seasons (2021-2025), R2=0.49. ",
"Baseline = Detroit 2024-25 extrapolated to 82 games. Playoff threshold = 92 pts.")))
)
)
)
)
# ── SERVER ────────────────────────────────────────────────────────────────────
server <- function(input, output, session) {
# Explorer
output$scatter <- renderPlotly({
d <- filter(games, Season %in% as.integer(input$season_filter))
m <- input$x_metric
p <- ggplot(d, aes(x=.data[[m]], y=Points_82, colour=is_Detroit,
shape=is_Detroit, size=is_Detroit,
text=paste0(Team," (",Season,")<br>Points: ",Points_82))) +
geom_point(alpha=0.8) +
scale_colour_manual(values=c("FALSE"=GRY,"TRUE"=RED)) +
scale_shape_manual(values=c("FALSE"=4,"TRUE"=16)) +
scale_size_manual(values=c("FALSE"=2,"TRUE"=4)) +
geom_vline(xintercept=50, linetype="dashed", colour=BLUE) +
labs(x=m, y="Points (82-game pace)", colour=NULL, shape=NULL, size=NULL) +
theme_minimal(base_size=12) + theme(legend.position="none")
if (input$show_trend)
p <- p + geom_smooth(aes(x=.data[[m]], y=Points_82, group=1),
method="lm", se=FALSE, colour=BLUE,
linewidth=0.8, inherit.aes=FALSE)
ggplotly(p, tooltip="text")
})
output$scatter_insight <- renderUI({
d   <- filter(games, Season %in% as.integer(input$season_filter))
det <- filter(d, is_Detroit)
gap <- round(mean(d[[input$x_metric]]) - mean(det[[input$x_metric]]), 2)
good_box(icon("lightbulb"), strong(" Detroit vs League: "),
paste0("Detroit averages ", round(mean(det[[input$x_metric]]),2),
"% vs the league's ", round(mean(d[[input$x_metric]]),2),
"% - a gap of ", gap, " points. The dashed line marks the 50% break-even threshold."))
})
# Trends
output$trend_plot <- renderPlotly({
m     <- input$trend_metric
lbl   <- names(metric_labels)[metric_labels == m]
det_d <- filter(games, is_Detroit) %>% arrange(Season) %>% select(Season, val=all_of(m))
avg_d <- league_avg %>% select(Season, val=all_of(m))
p <- ggplot() +
geom_line(data=avg_d,  aes(Season,val,colour="League Avg"), linewidth=1.2, linetype="dashed") +
geom_point(data=avg_d, aes(Season,val,colour="League Avg"), size=3) +
geom_line(data=det_d,  aes(Season,val,colour="Detroit"),    linewidth=1.8) +
geom_point(data=det_d, aes(Season,val,colour="Detroit"),    size=5) +
scale_colour_manual(values=c("Detroit"=RED,"League Avg"=GRY)) +
scale_x_continuous(breaks=sort(unique(games$Season))) +
labs(x="Season", y=lbl, colour=NULL) +
theme_minimal(base_size=12) + theme(legend.position="bottom")
if (m %in% c("xGF.","HDCF."))
p <- p + geom_hline(yintercept=50, linetype="dotted", colour=BLUE)
ggplotly(p) %>% layout(legend=list(orientation="h", y=-0.15))
})
output$trend_table <- renderDT({
filter(games, is_Detroit) %>% arrange(Season) %>%
select(Season, W, L, Pts=Points_82, xGF=xGF., HDCF=HDCF.) %>%
datatable(options=list(pageLength=5, dom="t"), rownames=FALSE)
})
output$trend_insight <- renderUI({
m   <- input$trend_metric
d   <- filter(games, is_Detroit) %>% arrange(Season)
chg <- round(last(d[[m]]) - first(d[[m]]), 2)
good_box(icon("chart-line"), strong(" Trend: "),
paste0("Detroit's ", names(metric_labels)[metric_labels==m],
" changed by ", ifelse(chg>0,"+",""), chg, " from 2021 to 2025."))
})
# Simulator
p_vals <- reactive({
off <- 12.8 * input$off_pct / 100
def <- 12.8 - off
px  <- min(base_xgf  + off*input$xgf_m, 62)
ph  <- min(base_hdcf + off*input$hdcf_m + def*input$hdca_m, 62)
pp  <- max(60, min(130, predict(model, data.frame(xGF.=px, HDCF.=ph))))
rk  <- sum(filter(games, Season==2024)$Points_82 > pp) + 1
list(off=off, def=def, px=px, ph=ph, pp=pp,
dx=px-base_xgf, dh=ph-base_hdcf, dp=pp-base_pts,
rk=rk, playoff=pp>=92)
})
output$alloc_table <- renderTable({
v <- p_vals()
data.frame(
Allocation = c("Elite Offence","Elite Defence","Total"),
Pct        = c(paste0(input$off_pct,"%"), paste0(100-input$off_pct,"%"), "100%"),
Amount     = c(paste0("$",round(v$off,1),"M"), paste0("$",round(v$def,1),"M"), "$12.8M")
)
}, striped=TRUE, bordered=TRUE)
output$vb_xgf    <- renderValueBox(valueBox(paste0(round(p_vals()$px,2),"%"),
paste0("xGF% (",sprintf("%+.2f",p_vals()$dx),"%)"), icon("crosshairs"),
color=if(p_vals()$px>=50)"green" else "yellow"))
output$vb_hdcf   <- renderValueBox(valueBox(paste0(round(p_vals()$ph,2),"%"),
paste0("HDCF% (",sprintf("%+.2f",p_vals()$dh),"%)"), icon("shield-alt"),
color=if(p_vals()$ph>=50)"green" else "yellow"))
output$vb_pts    <- renderValueBox(valueBox(round(p_vals()$pp,0),
paste0("Points (",sprintf("%+.0f",p_vals()$dp)," vs baseline)"), icon("star"),
color=if(p_vals()$pp>=92)"green" else "red"))
output$vb_rank   <- renderValueBox(valueBox(paste0("#",p_vals()$rk," / 32"),
"Est. League Rank", icon("list-ol"),
color=if(p_vals()$rk<=16)"green" else "yellow"))
output$vb_playoff <- renderValueBox(valueBox(
if(p_vals()$playoff)"IN PLAYOFFS" else "MISSED PLAYOFFS",
"Projection (92-pt threshold)",
icon(if(p_vals()$playoff)"check-circle" else "times-circle"),
color=if(p_vals()$playoff)"green" else "red"))
output$sim_bars <- renderPlotly({
v  <- p_vals()
df <- data.frame(
Category = rep(c("Baseline","Projected"),2),
Metric   = c(rep("xGF%",2),rep("HDCF%",2)),
Value    = c(base_xgf, v$px, base_hdcf, v$ph)
)
p <- ggplot(df, aes(Category, Value, fill=Metric,
text=paste0(Metric,": ",round(Value,2),"%"))) +
geom_col(position="dodge", width=0.6) +
geom_hline(yintercept=50, linetype="dashed") +
scale_fill_manual(values=c("xGF%"=RED,"HDCF%"=BLUE)) +
coord_cartesian(ylim=c(42,58)) +
labs(x=NULL, y="%") + theme_minimal(base_size=11) +
theme(legend.position="bottom")
ggplotly(p, tooltip="text")
})
output$sim_insight <- renderUI({
v <- p_vals(); pct <- input$off_pct
if (pct >= 70)
warn_box(icon("rocket"), strong(paste0(" Aggressive Offence (",pct,"% / $",round(v$off,1),"M): ")),
paste0("Projects xGF% to ",round(v$px,1),"% (+",round(v$dx,1)," pts). High upside but only $",
round(v$def,1),"M left for defence - risks a top-heavy roster."))
else if (pct <= 30)
good_box(icon("shield-alt"), strong(paste0(" Defensive Focus (",100-pct,"% / $",round(v$def,1),"M): ")),
paste0("Improves HDCF% by +",round(v$dh,1)," pts but xGF% only reaches ",round(v$px,1),
"%. xGF% has 6x the point impact - may leave wins on the table."))
else
good_box(icon("balance-scale"), strong(paste0(" Balanced (",pct,"/",100-pct,"): ")),
paste0("Projects ",round(v$pp,0)," points (xGF%: ",round(v$px,1),"%, HDCF%: ",
round(v$ph,1),"%). Consider tilting toward offence given xGF% stronger impact."))
})
}
shinyApp(ui, server)
